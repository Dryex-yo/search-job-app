APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sentry Error Tracking Configuration
SENTRY_ENABLED=true
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACE_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_TRACK_SQL_QUERIES=true
SENTRY_TRACK_QUERY_BINDINGS=false

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
BROADCAST_DRIVER=reverb

# Reverb WebSocket Configuration
REVERB_APP_ID=1
REVERB_APP_KEY=default-app-key
REVERB_APP_SECRET=default-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Vite Frontend Environment Variables
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
VITE_REVERB_APP_KEY=default-app-key

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email Configuration
# Set MAIL_MAILER to 'smtp' for production or 'log' for development

# Default mailer driver
MAIL_MAILER=log

# SMTP Configuration (for production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=465
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_SCHEME=tls

# From Address
MAIL_FROM_ADDRESS="noreply@dryex.com"
MAIL_FROM_NAME="Dryex - Platform Pencarian Kerja"

# For development/testing with Mailpit:
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Interview Scheduling & Calendar Integration ---
# Default meeting provider for interviews: zoom, google_meet, or auto
DEFAULT_MEETING_PROVIDER=google_meet

# Google Calendar Configuration
# Path to Google Calendar credentials JSON file (relative to project root)
# See: https://developers.google.com/calendar/api/quickstart/php
GOOGLE_CALENDAR_CREDENTIALS_PATH=secrets/google-calendar-credentials.json

# Zoom Configuration (Optional - only if using Zoom meetings)
# Get credentials from: https://developers.zoom.us/docs/internal-apps/
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
