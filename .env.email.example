# Email Configuration
# Set MAIL_MAILER to 'smtp' for production or 'log' for development

# Default mailer driver
MAIL_MAILER=log

# SMTP Configuration (for production)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=465
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_SCHEME=tls

# From Address
MAIL_FROM_ADDRESS="noreply@dryex.com"
MAIL_FROM_NAME="Dryex - Platform Pencarian Kerja"

# For development/testing with Mailpit:
# MAIL_MAILER=smtp
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SCHEME=null
